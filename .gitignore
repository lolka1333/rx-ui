# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# Frontend / Node
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# SQLite
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Backend runtime data (DB, xray binary, geofiles, generated config,
# secrets) — operator-specific, never source. Ignore the whole dir.
# The path is relative to the process's working directory, so it lands
# wherever the binary was started from: backend/ during development, the
# repo root from the workspace, frontend/ from a stray terminal. Match the
# directory at any depth rather than enumerating the spots — no tracked
# source directory is named `data` (`backend/proto/common/geodata/` is a
# different component and unaffected).
data/

# Backend secrets — never commit JWT secrets or .env
.env
.env.local
.env.production

# IDE / editor
.vscode/
.idea/
*.iml
*.swp
.DS_Store
Thumbs.db

# Logs / temp
*.log
/tmp/
*.tmp

# Build artifacts / archives — should not be in source tree
*.zip
*.tar.gz
*.tgz
*.7z

# Claude Code session artifacts
.claude/
